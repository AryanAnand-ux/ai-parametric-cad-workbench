# Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit the .env file to git

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HOST=0.0.0.0
PORT=8000
RELOAD=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set this in production to protect cleanup, model listing, and source retrieval.
ADMIN_TOKEN=
ENVIRONMENT=development
CAD_MAX_CONCURRENT_EXECUTIONS=2
CAD_EXECUTION_TIMEOUT_SECONDS=60
# Keep startup fast and deterministic. Run the RAG indexing command explicitly
# during setup/CI, or set true if you want the API to build the index on boot.
RAG_BUILD_ON_STARTUP=false

# ---------------------------------------------------------------------------
# Gemini Web / Gemini-Web2API Settings (Free Web Generation Fallback)
# ---------------------------------------------------------------------------
# Enable direct Gemini Web fallback when official API key is absent or exhausted
GEMINI_WEB_ENABLED=false

# Optional: Paste browser cookie string (__Secure-1PSID=...; SID=...;)
# If omitted, anonymous / public web access will be used.
GEMINI_WEB_COOKIE=

# Optional: Path to cookie file (git-ignored)
GEMINI_WEB_COOKIE_FILE=.gemini_cookie

# Model for Gemini Web (gemini-3.6-flash, gemini-3.5-flash-thinking, gemini-flash-lite)
GEMINI_WEB_MODEL=gemini-3.6-flash

# Gemini Web build label. If web requests return HTTP 405, refresh this from Gemini page metadata.
GEMINI_WEB_BL=boq_assistant-bard-web-server_20260716.08_p0

# Optional signed-in account metadata. If your Gemini URL is /u/1/app, set auth user to 1.
GEMINI_WEB_AUTH_USER=
GEMINI_WEB_XSRF_TOKEN=

# Optional proxy/retry controls for regions where gemini.google.com is slow or blocked.
GEMINI_WEB_PROXY=
GEMINI_WEB_RETRY_ATTEMPTS=3
GEMINI_WEB_RETRY_DELAY_SEC=2
GEMINI_WEB_TIMEOUT_SEC=180

# Optional: Standalone proxy settings (if running tools/run_gemini_web2api.py)
GEMINI_WEB2API_HOST=127.0.0.1
GEMINI_WEB2API_PORT=8081
GEMINI_WEB2API_KEY=
