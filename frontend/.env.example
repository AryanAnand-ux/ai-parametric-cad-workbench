# Backend API base URL.
# Set VITE_API_URL for separate-origin deploys (e.g. Vercel frontend + separate backend URL).
# Leave blank for docker/nginx same-origin deploys (Vite proxy / same host serves /api).
VITE_API_URL=
# Long-running generation and chat-to-modify timeout in milliseconds.
VITE_GENERATION_TIMEOUT_MS=300000
